ENVIRONMENT=development

# Local dev default: sqlite. In Azure, set via AKS secret to the Azure SQL connection string, e.g.:
# mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./bjjvault.db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

APPLICATIONINSIGHTS_CONNECTION_STRING=
